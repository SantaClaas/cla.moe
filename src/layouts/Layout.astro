---
interface Props {
	title?: string;
	description?: string;
}

const { title = 'cla.moe', description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} />}
		<title>{title}</title>
	</head>
	<body>
		<nav>
			<a href="/">Home</a>
			<a href="/about">About</a>
		</nav>
		<main>
			<slot />
		</main>
	</body>
</html>

<style>
	body {
		margin: 0 auto;
		padding: 1rem;
		max-width: 48rem;
		font-family: system-ui, sans-serif;
		line-height: 1.6;
	}
	nav {
		display: flex;
		gap: 1rem;
	}
</style>

---
import { buildInfo } from '../build-info';
import Layout from './Layout.astro';

interface Props {
	frontmatter: {
		title: string;
	};
}

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | cla.moe`}>
	<h1>{frontmatter.title}</h1>
	<slot />
	<footer>
		<dl>
			<dt>Version</dt>
			<dd>{buildInfo.version}</dd>
			<dt>Last built</dt>
			<dd>
				<time datetime={buildInfo.builtAt.toISOString()}>
					{buildInfo.builtAt.toLocaleString('en', { dateStyle: 'long', timeStyle: 'short', timeZone: 'UTC' })} UTC
				</time>
			</dd>
			{
				buildInfo.commitHash && (
					<>
						<dt>Commit</dt>
						<dd>
							<a href={buildInfo.commitUrl}>
								<code>{buildInfo.commitHash.slice(0, 7)}</code>
							</a>
						</dd>
					</>
				)
			}
		</dl>
	</footer>
</Layout>

<style>
	dl {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.25rem 1rem;
	}
	dd {
		margin: 0;
	}
</style>

---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
	(a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf(),
);
---

<Layout>
	<h1>cla.moe</h1>
	<ul>
		{
			posts.map((post) => (
				<li>
					<a href={`/posts/${post.id}/`}>{post.data.title}</a>
					<time datetime={post.data.pubDatetime.toISOString()}>
						{post.data.pubDatetime.toLocaleDateString('en')}
					</time>
				</li>
			))
		}
	</ul>
</Layout>
